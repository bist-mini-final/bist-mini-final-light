# PostgreSQL with pgvector installed. Use a dedicated learning database.
PGVECTOR_URL=postgresql://postgres:postgres@localhost:5432/rag_flow_light

# Required only when running LLM/embedding features.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# FastAPI starts and stops the local workers automatically.
LOCAL_WORKERS_ENABLED=true
WORKFLOW_QUEUE=workflow-core
INGESTION_SHARDS_ENABLED=false
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5

# Personal, loopback-only learning environment.
AUTH_ENABLED=false

# Select each stage independently: openai or llamacpp.
LLM_PROVIDER=openai
VLM_PROVIDER=openai
EMBEDDING_PROVIDER=openai
OPENAI_LLM_MODEL=gpt-5.6-luna
OPENAI_VLM_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# CUDA llama.cpp: Qwen3-VL 4B serves both text and vision; BGE-M3 is separate.
LLAMA_CPP_LLM_URL=http://127.0.0.1:8081/v1
LLAMA_CPP_VLM_URL=http://127.0.0.1:8081/v1
LLAMA_CPP_EMBEDDING_URL=http://127.0.0.1:8083/v1
LLAMA_CPP_LLM_MODEL=qwen3-vl-4b
LLAMA_CPP_VLM_MODEL=qwen3-vl-4b
LLAMA_CPP_EMBEDDING_MODEL=bge-m3
LLAMA_CPP_EMBEDDING_DIMENSION=1024
LLAMA_CPP_EMBEDDING_BATCH_SIZE=16

# Optional project-local services, installed separately (no Docker).
LOCAL_POSTGRES_AUTOSTART=false
LOCAL_POSTGRES_BIN=.runtime/postgres/Library/bin
LOCAL_POSTGRES_DATA=data/postgres
LOCAL_POSTGRES_PORT=5433
LLAMA_CPP_AUTOSTART=false
LLAMA_ARG_REASONING=off
LLAMA_CPP_SERVER_PATH=.runtime/llama/llama-server.exe
LLAMA_CPP_LLM_GGUF=models/Qwen3VL-4B-Instruct-Q4_K_M.gguf
LLAMA_CPP_VLM_GGUF=models/Qwen3VL-4B-Instruct-Q4_K_M.gguf
LLAMA_CPP_MMPROJ=models/mmproj-Qwen3VL-4B-Instruct-Q8_0.gguf
LLAMA_CPP_EMBEDDING_GGUF=models/bge-m3-Q8_0.gguf
